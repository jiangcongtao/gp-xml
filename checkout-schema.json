{
    "version": "1.0",
    "definitions": {
        "Hotel_Code": {
            "description": "酒店唯一标识码，由5位字母数字组成",
            "type": "string",
            "format": "^[A-Z0-9]{5}$",
            "maxLength": 10,
            "example": "PEKSH",
            "required": true
        },
        "Hotel_Name": {
            "description": "酒店名称",
            "type": "string",
            "maxLength": 100,
            "example": "beijingshunyixierdunhuitingjiudian",
            "required": true
        },
        "Brand_Code": {
            "description": "品牌代码，2位字符标识",
            "type": "string",
            "maxLength": 2,
            "example": "HT",
            "required": true
        },
        "Business_Date": {
            "description": "营业日期",
            "type": "date",
            "format": "MM/DD/YY",
            "example": "10/14/25",
            "required": true
        },
        "Hms_Version": {
            "description": "HMS系统版本号",
            "type": "string",
            "maxLength": 20,
            "example": "XPMS_1.0.1",
            "required": true
        },
        "Currency_Code": {
            "description": "货币代码，ISO 4217标准3位代码",
            "type": "string",
            "format": "^[A-Z]{3}$",
            "maxLength": 3,
            "example": "CNY",
            "required": true
        },
        "Hilstar_Ind": {
            "description": "是否参与Hilstar计划指标",
            "type": "integer",
            "enum": [0, 1],
            "example": 1,
            "required": true
        },
        "Encription_on": {
            "description": "是否启用加密指标",
            "type": "integer",
            "enum": [0, 1],
            "example": 0,
            "required": true
        },
        "Default_Print_Language": {
            "description": "默认打印语言ID",
            "type": "integer",
            "example": 1,
            "required": true
        },
        "Default_PBX_Language": {
            "description": "默认PBX语言ID",
            "type": "integer",
            "example": 1,
            "required": true
        },
        "Hotel_Address_line_1": {
            "description": "酒店地址第一行",
            "type": "string",
            "maxLength": 100,
            "required": false
        },
        "Hotel_City": {
            "description": "酒店所在城市",
            "type": "string",
            "maxLength": 50,
            "example": "Beijing",
            "required": true
        },
        "Hotel_Country": {
            "description": "酒店所在国家，ISO 3166-1 alpha-2代码",
            "type": "string",
            "format": "^[A-Z]{2}$",
            "maxLength": 2,
            "example": "CN",
            "required": true
        },
        "Hotel_Postal_Code": {
            "description": "酒店邮政编码",
            "type": "string",
            "maxLength": 20,
            "required": false
        },
        "Hotel_Phone_Number": {
            "description": "酒店电话号码",
            "type": "string",
            "maxLength": 30,
            "required": false
        },
        "stay_id": {
            "description": "住宿记录唯一标识",
            "type": "string",
            "format": "^[0-9]+$",
            "maxLength": 20,
            "example": "148291001",
            "required": true
        },
        "room_id": {
            "description": "房间号",
            "type": "string",
            "maxLength": 10,
            "example": "5608",
            "required": true
        },
        "room_type": {
            "description": "房间类型代码",
            "type": "string",
            "maxLength": 10,
            "example": "SKJS",
            "required": true
        },
        "stay_status": {
            "description": "住宿状态",
            "type": "string",
            "maxLength": 1,
            "validValues": "O=已退房, I=在住",
            "example": "O",
            "required": true
        },
        "reservation_date": {
            "description": "预订日期",
            "type": "date",
            "format": "MM/DD/YY",
            "example": "10/13/25",
            "required": true
        },
        "arrival_date": {
            "description": "入住日期",
            "type": "date",
            "format": "MM/DD/YY",
            "example": "10/13/25",
            "required": true
        },
        "departure_date": {
            "description": "离店日期",
            "type": "date",
            "format": "MM/DD/YY",
            "example": "10/14/25",
            "required": true
        },
        "original_departure_date": {
            "description": "原始预定离店日期",
            "type": "date",
            "format": "MM/DD/YY",
            "example": "10/14/25",
            "required": true
        },
        "number_of_adults": {
            "description": "成人数量",
            "type": "integer",
            "minimum": 0,
            "example": 1,
            "required": true
        },
        "number_of_children": {
            "description": "儿童数量",
            "type": "integer",
            "minimum": 0,
            "example": 0,
            "required": true
        },
        "rate_plan_id": {
            "description": "价格计划ID",
            "type": "string",
            "maxLength": 10,
            "example": "H1P",
            "required": true
        },
        "rate_plan_type": {
            "description": "价格计划类型",
            "type": "string",
            "maxLength": 1,
            "enum": ["L", "C", "D", "S", "V"],
            "enumDescriptions": {
                "L": "Local (本地)",
                "C": "Convention (会议)",
                "D": "Dayuse (日用)",
                "S": "System (系统)",
                "V": "Rack (门市价)"
            },
            "example": "L",
            "required": true
        },
        "rate_plan_desc": {
            "description": "价格计划描述",
            "type": "string",
            "maxLength": 100,
            "required": false
        },
        "room_rate": {
            "description": "房价",
            "type": "decimal",
            "format": "最多2位小数",
            "example": 469.42,
            "required": true
        },
        "checkout_type": {
            "description": "退房类型",
            "type": "string",
            "maxLength": 1,
            "enum": ["I", "P", "R", "V", "G", "K"],
            "enumDescriptions": {
                "I": "In Person (亲自退房)",
                "P": "Phone ZipOuts (电话快速退房)",
                "R": "Room Found Vacant (发现房间空置)",
                "V": "Video Checkouts (视频退房)",
                "G": "Group Checkouts (团队退房)",
                "K": "Kiosk Checkouts (自助机退房)"
            },
            "example": "I",
            "required": true
        },
        "checkin_source_code": {
            "description": "入住来源代码",
            "type": "string",
            "maxLength": 2,
            "enum": ["E", "F", "EF", "K", "EK", "P", "EP"],
            "enumDescriptions": {
                "E": "ECHECKIN (电子入住)",
                "F": "FRONT DESK (前台)",
                "EF": "ECHECKIN BY FRONT DESK (前台电子入住)",
                "K": "KIOSK (自助机)",
                "EK": "ECHECKIN BY KIOSK (自助机电子入住)",
                "P": "PERSONAL ASSISTANT (私人助理)",
                "EP": "ECHECKIN BY PERSONAL ASSISTANT (私人助理电子入住)"
            },
            "example": "F",
            "required": true
        },
        "stay_reason": {
            "description": "住宿原因",
            "type": "string",
            "maxLength": 1,
            "enum": ["C", "H", "O", "P", "R"],
            "enumDescriptions": {
                "C": "GUEST COMP (免费客人)",
                "H": "HOUSE USE (内部使用)",
                "O": "OWNER COMP (业主免费)",
                "P": "PERMANENT RESIDENT (常住客人)",
                "R": "GUEST RENTAL (付费客人)"
            },
            "example": "R",
            "required": true
        },
        "source_of_bus_code": {
            "description": "业务来源代码",
            "type": "integer",
            "enum": [0, 1, 2, 4, 8, 16],
            "enumDescriptions": {
                "0": "Central Reservations Office (中央预订中心)",
                "1": "Hotel To Hotel (酒店间)",
                "2": "Own Hotel (本酒店)",
                "4": "Airline/Internet (航空/互联网)",
                "8": "Walkin (上门客人)",
                "16": "CRO/Travel Agent (中央预订/旅行社)"
            },
            "example": 0,
            "required": true
        },
        "travel_reason_code": {
            "description": "出行原因代码",
            "type": "string",
            "maxLength": 1,
            "enum": ["A", "B", "C", "D", "E", "F", "G", "H", "I", "L", "N", "O", "R", "V", "W", "Z"],
            "enumDescriptions": {
                "A": "CONVENTION/ASSOCIATION (会议/协会)",
                "B": "RACK (门市价)",
                "C": "CONSORTIA (联盟)",
                "D": "SMERF (社会/军事/教育/宗教/兄弟会)",
                "E": "CORPORATE MARKETING PROGRAMS (企业营销计划)",
                "F": "PERMANENT (常住)",
                "G": "GOVERNMENT (政府)",
                "H": "HOUSE USE (内部使用)",
                "I": "INDIVIDUAL TOUR/WHOLESALE (个人游/批发)",
                "L": "OTHER DISCOUNTS (其他折扣)",
                "N": "TRAVEL INDUSTRY DISCOUNT (旅游业折扣)",
                "O": "GROUP TOUR (团队游)",
                "R": "COMPANY MEETINGS/INCENTIVES (公司会议/奖励)",
                "V": "CORPORATE NEGOTIATED (企业协议价)",
                "W": "LOCAL NEGOTIATED (本地协议价)",
                "Z": "COMP ROOM (免费房)"
            },
            "example": "E",
            "required": true
        },
        "walkin_status": {
            "description": "是否为上门客人",
            "type": "string",
            "enum": ["Y", "N"],
            "example": "N",
            "required": true
        },
        "comp_status": {
            "description": "是否为免费住宿",
            "type": "integer",
            "enum": [0, 1],
            "example": 0,
            "required": true
        },
        "meta_status": {
            "description": "Meta状态",
            "type": "string",
            "enum": ["Y", "N"],
            "example": "N",
            "required": true
        },
        "one_bedroom_suite_status": {
            "description": "是否为一居室套房",
            "type": "string",
            "enum": ["Y", "N"],
            "example": "N",
            "required": true
        },
        "sell_thru_status": {
            "description": "Sell-thru状态",
            "type": "string",
            "enum": ["Y", "N"],
            "example": "N",
            "required": true
        },
        "hide_rates": {
            "description": "是否隐藏价格",
            "type": "integer",
            "enum": [0, 1],
            "example": 0,
            "required": true
        },
        "honors_points_eligibility": {
            "description": "是否有资格获得荣誉积分",
            "type": "integer",
            "enum": [0, 1],
            "example": 1,
            "required": true
        },
        "crs_commission_paid_cntrl_ind": {
            "description": "CRS佣金支付控制指标",
            "type": "integer",
            "enum": [0, 1],
            "example": 0,
            "required": true
        },
        "crs_chained_ind": {
            "description": "CRS链接指标",
            "type": "integer",
            "enum": [0, 1],
            "example": 0,
            "required": true
        },
        "comm_pay_change": {
            "description": "佣金支付变更指标",
            "type": "string",
            "enum": ["Y", "N"],
            "example": "N",
            "required": true
        },
        "crs_property_id": {
            "description": "CRS物业ID",
            "type": "string",
            "maxLength": 10,
            "example": "PEKSH",
            "required": true
        },
        "booked_by": {
            "description": "预订来源物业",
            "type": "string",
            "maxLength": 10,
            "example": "PEKSH",
            "required": true
        },
        "crs_commission_amount": {
            "description": "CRS佣金金额",
            "type": "decimal",
            "format": "最多2位小数",
            "required": false
        },
        "crs_commission_paid_to": {
            "description": "CRS佣金支付对象",
            "type": "string",
            "maxLength": 1,
            "required": false
        },
        "crs_commission_type": {
            "description": "CRS佣金类型",
            "type": "string",
            "maxLength": 1,
            "required": false
        },
        "primary_airline": {
            "description": "主要航空公司代码",
            "type": "string",
            "maxLength": 2,
            "example": "AA",
            "required": false,
            "crossFieldRule": "如果存在且非空，secondary_airline也必须存在且非空"
        },
        "secondary_airline": {
            "description": "次要航空公司代码",
            "type": "string",
            "maxLength": 2,
            "example": "UA",
            "required": false,
            "crossFieldRule": "如果存在且非空，primary_airline也必须存在且非空"
        },
        "guest_id": {
            "description": "客人唯一标识",
            "type": "string",
            "maxLength": 20,
            "example": "000016907",
            "required": true
        },
        "guest_status": {
            "description": "客人状态",
            "type": "string",
            "maxLength": 1,
            "validValues": "O=已退房, I=在住",
            "example": "O",
            "required": true
        },
        "guest_lastname": {
            "description": "客人姓氏",
            "type": "string",
            "maxLength": 50,
            "example": "Hilton1",
            "required": true
        },
        "guest_firstname": {
            "description": "客人名字",
            "type": "string",
            "maxLength": 50,
            "example": "RAJANI",
            "required": true
        },
        "guest_arrival_date": {
            "description": "客人入住日期",
            "type": "date",
            "format": "MM/DD/YY",
            "example": "10/13/25",
            "required": true,
            "crossFieldRule": "必须与父级STAY的arrival_date匹配"
        },
        "guest_departure_date": {
            "description": "客人离店日期",
            "type": "date",
            "format": "MM/DD/YY",
            "example": "10/14/25",
            "required": true,
            "crossFieldRule": "必须与父级STAY的departure_date匹配"
        },
        "guarantor_ind": {
            "description": "是否为担保人",
            "type": "integer",
            "enum": [0, 1],
            "example": 1,
            "required": true
        },
        "guarantee_type": {
            "description": "担保类型（PCRS代码）",
            "type": "string",
            "maxLength": 2,
            "enum": ["10", "12", "2P", "4P", "6P", "C1", "CC", "CD", "CO", "CP", "CR", "DB", "DP", "FP", "GA", "GC", "GD", "IA", "IN", "ND", "NN", "PD", "PM", "PR", "PT", "QC", "QW", "TA", "VC", "VG", "WV", "ZD", "ZG"],
            "enumDescriptions": {
                "10": "10PM Hold/No Guarantee (10点前保留/无担保)",
                "12": "Cancel before 12PM (12点前取消)",
                "2P": "2PM Hold/No Guarantee (下午2点保留)",
                "4P": "4PM Courtesy Hold (下午4点礼貌保留)",
                "6P": "Hold Until 6PM (保留至下午6点)",
                "C1": "Profile Credit Card (信用卡档案)",
                "CC": "Guarantee by Credit Card (信用卡担保)",
                "CD": "Guarantee by CC Deposit (信用卡押金担保)",
                "CO": "Corporate Profile (公司档案)",
                "CP": "Credit Card - Early Arrival (信用卡-提前到达)",
                "CR": "Guarantee by Corporate Account (公司账户担保)",
                "DB": "Direct Bill (直接记账)",
                "DP": "Deposit and Pre-Reg (押金和预登记)",
                "FP": "Full Payment No Refund (全额付款不退款)",
                "GA": "Guaranteed to Guest Address (担保至客人地址)",
                "GC": "Guaranteed by Corporate Account (公司账户担保)",
                "GD": "GDS Deposit (GDS押金)",
                "IA": "Guaranteed by Travel Agent (旅行社担保)",
                "IN": "Guarantee to Property (酒店担保)",
                "ND": "Guaranteed by Need Deposit (需要押金担保)",
                "NN": "Cancel before 12PM (12点前取消)",
                "PD": "Guaranteed by Paid Deposit (已付押金担保)",
                "PM": "Hold Until 6PM (保留至下午6点)",
                "PR": "Pre-Register (预登记)",
                "PT": "Paytell Utell Int'l (Paytell国际)",
                "QC": "Quick-Check Waive (快速入住免担保)",
                "QW": "Quick-Check Waive (快速入住免担保)",
                "TA": "Guaranteed by Travel Agent (旅行社担保)",
                "VC": "Guaranteed by Voucher (凭证担保)",
                "VG": "Verbal Guarantee (口头担保)",
                "WV": "Waive Guarantee Deposit (免除担保押金)",
                "ZD": "Zip In Check In Deposit (快速入住押金)",
                "ZG": "Zip In Check In Guarantee (快速入住担保)"
            },
            "example": "6P",
            "required": true
        },
        "travel_agent_guarantee_ind": {
            "description": "旅行社担保指标",
            "type": "integer",
            "enum": [0, 1],
            "example": 0,
            "required": true,
            "crossFieldRule": "如果为1，guarantee_type应为TA或IA"
        },
        "corporate_guarantee_ind": {
            "description": "公司担保指标",
            "type": "integer",
            "enum": [0, 1],
            "example": 0,
            "required": true,
            "crossFieldRule": "如果为1，guarantee_type应为CR、GC或CO"
        },
        "honors_num": {
            "description": "荣誉会员号码",
            "type": "string",
            "maxLength": 20,
            "example": "003134273",
            "required": false,
            "crossFieldRule": "如果存在且非空，honors_tier_type也应存在"
        },
        "honors_tier_type": {
            "description": "荣誉会员等级",
            "type": "string",
            "maxLength": 1,
            "enum": ["M", "S", "G", "D"],
            "enumDescriptions": {
                "M": "Member (会员)",
                "S": "Silver (银卡)",
                "G": "Gold (金卡)",
                "D": "Diamond (钻石卡)"
            },
            "example": "G",
            "required": false
        },
        "print_language_id": {
            "description": "打印语言ID",
            "type": "integer",
            "example": 1,
            "required": true
        },
        "language_id": {
            "description": "语言ID",
            "type": "integer",
            "example": 1,
            "required": true
        },
        "guest_currency_code": {
            "description": "客人货币代码，ISO 4217标准",
            "type": "string",
            "format": "^[A-Z]{3}$",
            "maxLength": 3,
            "example": "CNY",
            "required": true,
            "crossFieldRule": "应与System21/Currency_Code一致"
        },
        "travel_agent_id": {
            "description": "旅行社ID",
            "type": "string",
            "maxLength": 20,
            "example": "TA12345",
            "required": false,
            "crossFieldRule": "当STAY的primary_airline和secondary_airline都存在且非空时必填"
        },
        "address_type": {
            "description": "地址类型",
            "type": "string",
            "maxLength": 1,
            "validValues": "H=Home (家庭), B=Business (商务)",
            "example": "H",
            "required": true,
            "note": "如果ADDRESS元素存在则必填"
        },
        "email_address": {
            "description": "电子邮件地址",
            "type": "string",
            "format": "应包含@和.",
            "maxLength": 100,
            "example": "nick.jiang@hilton.com",
            "required": false
        },
        "phone_num": {
            "description": "电话号码",
            "type": "string",
            "format": "仅包含数字、空格、连字符、括号或加号",
            "maxLength": 30,
            "example": "15152887708",
            "required": false
        },
        "folio_id": {
            "description": "账单唯一标识",
            "type": "string",
            "format": "^[0-9]+$",
            "maxLength": 20,
            "example": "1482914001",
            "required": true
        },
        "tax_exempt_ind": {
            "description": "免税指标",
            "type": "string",
            "enum": ["Y", "N"],
            "example": "N",
            "required": true
        },
        "receipt_id": {
            "description": "收据唯一标识",
            "type": "string",
            "format": "^[0-9]+$",
            "maxLength": 20,
            "example": "1482914001",
            "required": true
        },
        "fb_mop_type": {
            "description": "账单支付方式类型",
            "type": "string",
            "maxLength": 2,
            "validValues": "CS=Cash (现金), CC=Credit Card (信用卡), CH=Check (支票), DB=Direct Bill (直接记账), AR=A/R Transfer (应收账款转账)",
            "example": "CS",
            "required": true
        },
        "confidential_ind": {
            "description": "保密指标",
            "type": "string",
            "enum": ["Y", "N"],
            "example": "N",
            "required": true
        },
        "accounting_id": {
            "description": "会计科目ID",
            "type": "string",
            "format": "^[0-9]+$",
            "maxLength": 10,
            "example": "1000",
            "required": true
        },
        "accounting_id_desc": {
            "description": "会计科目描述",
            "type": "string",
            "maxLength": 100,
            "example": "fangfei",
            "required": true
        },
        "trans_id": {
            "description": "交易唯一标识",
            "type": "string",
            "format": "^[0-9]+$",
            "maxLength": 20,
            "example": "148297854",
            "required": true
        },
        "trans_desc": {
            "description": "交易描述",
            "type": "string",
            "maxLength": 100,
            "example": "fangfei",
            "required": true
        },
        "entry_id": {
            "description": "分录唯一标识",
            "type": "string",
            "format": "^[0-9]+$",
            "maxLength": 20,
            "example": "148297854",
            "required": true
        },
        "employee_id": {
            "description": "操作员工ID",
            "type": "string",
            "maxLength": 20,
            "example": "HT3480008",
            "required": true
        },
