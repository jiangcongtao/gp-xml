        },
        "posting_type": {
            "description": "过账类型",
            "type": "string",
            "maxLength": 1,
            "validValues": "P=Primary (主要), S=Secondary/System (次要/系统)",
            "example": "P",
            "required": true
        },
        "entry_type": {
            "description": "分录类型",
            "type": "string",
            "maxLength": 6,
            "enum": ["APYMGR", "ADJUST", "PAYMNT", "APYTRN", "GSTSNR", "PAYOUT", "REFNOR", "ALLOWE", "GSTSAT", "CHARGE"],
            "enumDescriptions": {
                "APYMGR": "Manager Adjustment (经理调整)",
